{
  "name": "@little-nebulae/node-fs",
  "version": "0.0.1",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "try": "tsx ./src/try.ts",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.1.0",
    "@little-nebulae/result": "1.0.0",
    "@little-nebulae/system-error": "2.0.0",
    "@little-nebulae/type-utils": "1.1.0",
    "@types/node": "26.6.2",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.0.0",
    "@little-nebulae/result": "^1.0.0",
    "@little-nebulae/system-error": "^1.0.0",
    "@little-nebulae/type-utils": "^1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.2",
      "onFail": "warn"
    }
  },
  "packageManager": "pnpm@12.4.2"
}
