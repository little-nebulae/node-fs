{
  "name": "@little-nebulae/node-fs",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "tsdown",
    "try": "tsx ./src/try.ts",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "check": "pnpm run lint && pnpm run fmt:check",
    "fix": "pnpm run lint:fix && pnpm run fmt",
    "test": "vitest run"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@little-nebulae/error": "1.3.0",
    "@little-nebulae/result": "1.3.0",
    "@little-nebulae/system-error": "2.0.1",
    "@types/node": "26.6.4",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.25",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "type-fest": "5.10.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "@little-nebulae/error": "^1.3.0",
    "@little-nebulae/result": "^1.3.0",
    "@little-nebulae/system-error": "^2.0.1",
    "type-fest": "^5.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
